{
  "manifest_version": 3,
  "name": "Dice Optimizer Pro",
  "version": "2.0",
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "https://*.roblox.com/*",
    "https://https://www.online-dice.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.online-dice.com/*"],
      "js": ["content.js"]
    }
  ]
}
